# OpenRouter API Keys (支持多个,用逗号分隔,系统会自动轮询)
OPENROUTER_API_KEYS=your_key_1,your_key_2,your_key_3

# 模型配置
OPENROUTER_MODEL=alibaba/tongyi-deepresearch-30b-a3b:free

# 站点信息
SITE_URL=https://your-site-url.com
SITE_NAME=Your App Name

# 服务端口
SERVER_HOST=0.0.0.0
SERVER_PORT=9001

# Searxng配置
SEARXNG_HOST=http://localhost:8888

# Exa配置 (需要API Key: https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# 性能优化配置
# Memory配置 (记忆功能,默认启用,如需提速可设为false)
ENABLE_MEMORY=true

# 内置知识库配置 (ChromaDB + 智谱Embedding)
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DB_PATH=./data/chroma
KNOWLEDGE_COLLECTION_NAME=agno_knowledge
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_MAX_RESULTS=5

# 智谱AI配置 (用于Embedding向量化)
# 获取API Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_EMBEDDING_MODEL=embedding-3
