# OpenRouter API Keys (支持多个,用逗号分隔,系统会自动轮询)
OPENROUTER_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3

# 模型配置
OPENROUTER_MODEL=alibaba/tongyi-deepresearch-30b-a3b:free

# 站点信息
SITE_URL=https://your-site-url.com
SITE_NAME=Your App Name

# 服务端口
SERVER_HOST=0.0.0.0
SERVER_PORT=9001

# Searxng配置 (可选)
SEARXNG_HOST=http://localhost:53153

# Exa配置 (可选,需要API Key: https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# 性能优化配置
# Memory配置 (记忆功能,默认启用,如需提速可设为false)
ENABLE_MEMORY=true

# Knowledge配置 (知识库功能,默认禁用以提升性能)
ENABLE_KNOWLEDGE=true
KNOWLEDGE_DIR=tmp/lancedb
KNOWLEDGE_TABLE=knowledge_documents

# Knowledge性能优化 (使用FixedSizeChunking提速)
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_MAX_RESULTS=5

# Knowledge Embedding模型配置 (推荐使用智谱AI Embedding-3)
KNOWLEDGE_EMBEDDING_MODEL=embedding-3
KNOWLEDGE_EMBEDDING_API_KEY=your_zhipuai_api_key_here
KNOWLEDGE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
